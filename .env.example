# HTTP port the API listens on.
PORT=3000

# PostgreSQL connection. These defaults match docker/docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=while_building

# Browser origin(s) allowed by CORS — scheme + host (+ port), no trailing slash.
# Separate multiple origins with commas, e.g.
# CORS_ORIGIN=https://example.com,https://www.example.com
CORS_ORIGIN=http://localhost:5173
