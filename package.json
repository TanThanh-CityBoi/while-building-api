{
  "name": "while-building-api",
  "version": "0.1.0",
  "description": "Backend monorepo for While Building — NestJS apps (api, notification, webhook, integration, mcp, ai) and shared technical packages.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "turbo watch dev",
    "dev:api": "turbo watch dev --filter=@while-building/api",
    "dev:notification": "turbo watch dev --filter=@while-building/notification",
    "dev:webhook": "turbo watch dev --filter=@while-building/webhook",
    "dev:integration": "turbo watch dev --filter=@while-building/integration",
    "dev:mcp": "turbo watch dev --filter=@while-building/mcp",
    "dev:ai": "turbo watch dev --filter=@while-building/ai",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && turbo boundaries",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "turbo run db:migrate --filter=@while-building/api",
    "db:migrate:status": "turbo run db:migrate:status --filter=@while-building/api",
    "db:migrate:revert": "turbo run db:migrate:revert --filter=@while-building/api",
    "db:migration:generate": "turbo run db:migration:generate --filter=@while-building/api --",
    "db:seed": "turbo run db:seed --filter=@while-building/api",
    "db:seed:content": "turbo run db:seed:content --filter=@while-building/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
