# ─── Server ──────────────────────────────────────────────────────────────────
# HTTP port. The default, 3005, keeps it clear of the other apps
# (api 3000, notification 3001, webhook 3002, integration 3003, ai 3004).
PORT=3005
# development | production | test
NODE_ENV=development
# Interface to bind to. The MCP server is internal in V1 (no authentication):
# keep it on loopback or a private network.
MCP_HOST=127.0.0.1
# Host / Origin hostnames accepted on /mcp (DNS rebinding protection),
# comma-separated, without ports.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ─── While Building API ──────────────────────────────────────────────────────
# The only source of data: published content from its public routes.
API_URL=http://localhost:3000
# Timeout for each API request (seconds, or a number with s / m).
# API_TIMEOUT=5s
