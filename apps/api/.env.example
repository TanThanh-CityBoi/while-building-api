# ─── Server ──────────────────────────────────────────────────────────────────
# HTTP port the API listens on.
PORT=3000
# development | production | test. "production" turns on secure cookies, turns
# off Swagger by default and rejects placeholder secrets.
NODE_ENV=development
# Set when running behind a reverse proxy so client IPs (rate limiting) are
# correct, e.g. 1 for one proxy hop. See Express "trust proxy".
# TRUST_PROXY=1

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# These defaults match docker/docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=while_building

# ─── CORS ────────────────────────────────────────────────────────────────────
# Browser origin(s) allowed to call the API, with credentials (cookies).
# Scheme + host (+ port), no trailing slash; separate several with commas.
# In while-building-web the public client runs on :5173 and the CMS on :5174.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── Authentication ──────────────────────────────────────────────────────────
# Two DIFFERENT random secrets of at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-for-access-tokens
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-for-refresh-tokens
# Lifetimes: seconds, or a number with s / m / h / d.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie. COOKIE_SECURE defaults to true when NODE_ENV=production.
# Use COOKIE_SAME_SITE=none (which requires COOKIE_SECURE=true) only when the CMS
# and the API are on different sites.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# OpenAPI docs at /docs. Defaults to true unless NODE_ENV=production.
# SWAGGER_ENABLED=true

# ─── Root account (pnpm db:seed) ─────────────────────────────────────────────
# Only read by the seed, which creates the ROOT user if none exists. It never
# overwrites an existing ROOT. Use your own values; never commit real ones.
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=change-me-immediately
ROOT_NAME=Root
