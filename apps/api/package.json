{
  "name": "@while-building/api",
  "version": "0.1.0",
  "description": "While Building API — the main business API: authentication, users and (next) content.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:migrate": "nest build && pnpm db:migrate:prod",
    "db:migrate:prod": "typeorm migration:run -d dist/database/data-source.js",
    "db:migrate:revert": "nest build && typeorm migration:revert -d dist/database/data-source.js",
    "db:migrate:status": "nest build && typeorm migration:show -d dist/database/data-source.js",
    "db:migration:generate": "nest build && typeorm migration:generate -d dist/database/data-source.js",
    "db:seed": "nest build && pnpm db:seed:prod",
    "db:seed:prod": "node dist/database/seed.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "@node-rs/argon2": "^2.2.1",
    "@while-building/config": "workspace:*",
    "@while-building/database": "workspace:*",
    "@while-building/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.6",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
