# Template for apps/ai/.env: `cp apps/ai/.env.example apps/ai/.env`, then fill in the keys.
# Real keys go only in apps/ai/.env (git-ignored) — never in this file or in a VITE_* variable.
# Each provider has its own key, read only by its own adapter.

# ─── Server ──────────────────────────────────────────────────────────────────
# HTTP port. The default, 3004, keeps it clear of the other apps
# (api 3000, notification 3001, webhook 3002, integration 3003, mcp 3005).
PORT=3004
# development | production | test
NODE_ENV=development
# Browser origin(s) allowed to call POST /chat and GET /models: the CMS. Bare origins,
# comma-separated.
CORS_ORIGIN=http://localhost:5174
# Set when running behind a reverse proxy, e.g. 1 for one proxy hop.
# TRUST_PROXY=1

# ─── Other apps ──────────────────────────────────────────────────────────────
# The While Building API: authenticates the CMS user (GET /auth/me).
API_URL=http://localhost:3000
# The MCP server's endpoint (apps/mcp).
MCP_URL=http://127.0.0.1:3005/mcp

# ─── Provider selection ──────────────────────────────────────────────────────
# Enabled providers (anthropic, openai, gemini): the CMS offers only these, and POST /chat validates
# the user's choice. Every enabled provider needs its key in its own section below — the app
# refuses to start without OPENAI_API_KEY / GEMINI_API_KEY while openai / gemini is enabled.
# Remove a provider from the list until you have its key (e.g. AI_PROVIDERS=anthropic).
AI_PROVIDERS=anthropic,openai,gemini
# Used when a request names no provider; must be enabled.
AI_DEFAULT_PROVIDER=anthropic
# Shared by every provider: output tokens per model turn.
# AI_MAX_OUTPUT_TOKENS=64000

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# Anthropic key only (console.anthropic.com). Required in production when anthropic is enabled;
# in development it may stay empty if ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile exists.
ANTHROPIC_API_KEY=anthropic_api_key
# Offered models, from the catalog (src/llm/model-catalog.ts); the first is the default.
AI_ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5
# low | medium | high | xhigh | max
# AI_EFFORT=medium

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# OpenAI key only (platform.openai.com). Required while openai is in AI_PROVIDERS.
OPENAI_API_KEY=openai_api_key
# Offered models, from the catalog; the first is the default.
AI_OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
# none | minimal | low | medium | high | xhigh (unset: the model's default)
# AI_OPENAI_REASONING_EFFORT=

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Gemini key only (aistudio.google.com). Required while gemini is in AI_PROVIDERS.
GEMINI_API_KEY=
# Offered models, from the catalog; the first is the default.
AI_GEMINI_MODELS=gemini-pro-latest,gemini-flash-latest
# minimal | low | medium | high (unset: the model's default)
# AI_GEMINI_THINKING_LEVEL=

# ─── Limits ──────────────────────────────────────────────────────────────────
# Rounds of tool calls per answer, then the model answers with what it has.
# AI_MAX_TOOL_ROUNDS=5
# Total time for one answer, and for each MCP call (seconds, or with s / m).
# AI_REQUEST_TIMEOUT=90s
# AI_TOOL_TIMEOUT=10s
# Chat requests per user per window.
# AI_RATE_LIMIT=20
# AI_RATE_LIMIT_WINDOW=10m
