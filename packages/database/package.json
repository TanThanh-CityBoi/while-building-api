    "test": "vitest run"
  },
  "dependencies": {
    "@while-building/config": "workspace:*"
  },
  "peerDependencies": {
    "pg": "^8.23.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "pg": "^8.23.0",
    "typeorm": "^1.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
