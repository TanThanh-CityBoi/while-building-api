{
  "name": "@while-building/database",
  "version": "0.0.0",
  "description": "Generic PostgreSQL/TypeORM setup: DATABASE_* settings and data-source conventions. No entities, repositories or migrations.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
